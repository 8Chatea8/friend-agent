# 이 파일을 .env 로 복사해 값을 채운다. .env 는 저장소와 배포에 올라가지 않는다.
# LLM_PROVIDER: openai, gemini, claude, fake 중 하나. fake 는 키 없이 가짜 응답을 돌려준다.
LLM_PROVIDER=fake
LLM_API_KEY=
# 비워 두면 제공자별 기본 모델을 쓴다
LLM_MODEL=
ENV=local

# 저장소와 로그인. 처음에는 memory, none 으로 둔다. Supabase 연결은 docs/supabase.md
STORAGE=memory
AUTH=none
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
GOOGLE_LOGIN=false

# Langfuse 계측. 두 키가 다 있을 때만 켜진다. 비워 두면 아무것도 보내지 않는다
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 비워 두면 Langfuse Cloud 기본 주소를 쓴다
LANGFUSE_BASE_URL=
# 대화 원문을 보낼지. true 여도 전화번호, 이메일, 카드 번호는 가린다. 개인정보라 기본값은 false
LANGFUSE_CAPTURE_CONTENT=false
# 도구 선택 프롬프트 A/B 테스트. on 이면 사용자마다 prod-a 또는 prod-b 라벨을 쓴다(없으면 production)
AB_TEST=off
